generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// —— Auth.js ——

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  plants        Plant[]
  locations     CultivationLocation[]
  settings      UserSettings?
  alertDismissals AlertDismissal[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// —— Domínio ——

enum PlantOrigin {
  SEMENTE
  MUDA
  ENXERTO
  COMPRA
  CRUZAMENTO_PROPRIO
}

enum PlantPhase {
  MUDA_SEMENTE
  JOVEM
  ADULTA
  RECUPERACAO
  DORMENCIA
}

enum PlantStatus {
  SAUDAVEL
  STRESS
  DOENTE
  RECUPERACAO
  DORMENCIA
}

enum EventType {
  CHEGADA
  REGA
  ADUBACAO
  REPLANTIO
  PODA
  MUDANCA_SOL
  FLORACAO
  DOENCA
  PRAGA
  TRATAMENTO
  FOTO
  CRUZAMENTO
  SEMENTES
  POLINIZACAO
  RESULTADO_POLINIZACAO
  NOTA
}

model CultivationLocation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  exposedToRain Boolean  @default(true)
  notes         String?
  plants        Plant[]
  createdAt     DateTime @default(now())
}

model Plant {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  code               String
  nickname           String?
  origin             PlantOrigin         @default(SEMENTE)
  phase              PlantPhase          @default(MUDA_SEMENTE)
  status             PlantStatus         @default(SAUDAVEL)
  heightCm           Float?
  arrivedAt          DateTime            @default(now())
  substrateNotes     String?
  potPreset          String?
  potDiameterCm      Float?
  potVolumeLiters    Float?
  potLabel           String?
  sunExposurePercent Int                 @default(80)
  locationId         String?
  location           CultivationLocation? @relation(fields: [locationId], references: [id])
  parentMaleId       String?
  parentFemaleId     String?
  parentMale         Plant?              @relation("ParentMale", fields: [parentMaleId], references: [id])
  parentFemale       Plant?              @relation("ParentFemale", fields: [parentFemaleId], references: [id])
  childrenAsMale     Plant[]             @relation("ParentMale")
  childrenAsFemale   Plant[]             @relation("ParentFemale")
  events             PlantEvent[]
  photos             PlantPhoto[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, code])
}

model PlantEvent {
  id         String       @id @default(cuid())
  plantId    String
  plant      Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  type       EventType
  occurredAt DateTime     @default(now())
  title      String?
  notes      String?
  metadata   String?
  photos     PlantPhoto[]
  createdAt  DateTime     @default(now())
}

model PlantPhoto {
  id        String      @id @default(cuid())
  plantId   String
  plant     Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  eventId   String?
  event     PlantEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  path      String
  caption   String?
  takenAt   DateTime    @default(now())
  createdAt DateTime    @default(now())
}

model UserSettings {
  userId               String  @id
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationLat          Float   @default(-22.68)
  locationLon          Float   @default(-44.32)
  cityName             String  @default("Bananal, SP")
  waterDaysSeedling    Int     @default(4)
  waterDaysAdult       Int     @default(10)
  fertDaysSeedling     Int     @default(14)
  fertDaysAdult        Int     @default(30)
  notificationsEnabled Boolean @default(true)
}

model AlertDismissal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertKey    String
  dismissedAt DateTime @default(now())

  @@unique([userId, alertKey])
}
