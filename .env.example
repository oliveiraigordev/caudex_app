# Banco (Postgres — Neon/Vercel Postgres em produção)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://caudexia.vercel.app"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect: https://caudexia.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple (opcional) — Apple Developer + Services ID
# Redirect: https://caudexia.vercel.app/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Fotos em produção (Vercel Blob — Storage no dashboard)
BLOB_READ_WRITE_TOKEN=""

# Web Push no navegador — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@exemplo.com"

# Cron Vercel (push de lembretes) — mesmo valor em Settings → Cron
CRON_SECRET=""
